# Copy to .env and fill in real values:  cp .env.example .env
#
# Compose auto-loads .env from the project root. Both variables below are
# required by the `api` service: it refuses to start without them, and
# app/config.py refuses to boot without them (design D10 - no secret ever
# gets a default, in source or in Compose).
#
# .env is gitignored. .env.example is not - never put a real value here.

# Signs the auth JWTs (HS256). Rotating it invalidates every issued token.
# MUST be at least 32 bytes (RFC 7518 3.2) - the app refuses to boot on a
# shorter one. Do not hand-type this; generate it:
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Shared secret that gates POST /auth/register. Without it anyone who can
# reach the API can create a tenant.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
REGISTRATION_TOKEN=

# Browser origins allowed to call this API, comma-separated. Required, with
# no default -- but an explicit empty value is a legal, deliberate answer
# meaning "no browser may call this API". The literal * is rejected at boot.
# For local frontend work this is Vite's dev server:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
