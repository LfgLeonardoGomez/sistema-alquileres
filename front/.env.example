# Copy this file to .env and fill in the values. There are no defaults for
# the required variables (design D37) -- a default is precisely how a
# production build ends up pointing at a developer's machine.

# Required, no default. The backend's origin. Note there is no dev proxy
# (design D37): the browser talks to the API cross-origin in development
# exactly as in production, so CORS_ALLOWED_ORIGINS on the backend must
# include this app's own origin (http://localhost:5173 by default).
VITE_API_BASE_URL=http://localhost:8000

# Required. The login screen's build-time fallback tenant slug; opening
# /login?tenant=<slug> overrides it for that visit only (design D31). The
# owner herself never sees this value -- it is not a form field.
VITE_TENANT_SLUG=mar-del-tuyu-cabins

# Optional. When unset, the "Escribinos por WhatsApp" button on the public
# availability page is not rendered at all -- never disabled, never a dead
# link (design D37).
# VITE_WHATSAPP_NUMBER=5492215551234
